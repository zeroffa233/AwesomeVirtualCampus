<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.vcampus.client.scene.TeachingAffairsController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: white;"
            stylesheets="@teachingaffairs.css">

    <children>
        <VBox alignment="CENTER" spacing="20"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- 欢迎标题 -->
            <Label fx:id="titleLabel"
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

            <!-- 副标题 -->
            <Label fx:id="subtitleLabel"
                   style="-fx-font-size: 20px; -fx-text-fill: #1565c0;" />

        </VBox>
    </children>
</AnchorPane>
