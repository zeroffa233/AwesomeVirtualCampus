<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXPasswordField?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" >
    <VBox spacing="16.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
        </padding>
        <Label style="-fx-font-size: 24px; -fx-font-weight: 600;" text="用户管理" />
        <BorderPane VBox.vgrow="ALWAYS">
            <center>
                <TableView fx:id="usersTable" BorderPane.alignment="CENTER">
                    <columns>
                        <TableColumn fx:id="cardNumCol" prefWidth="100.0" text="一卡通号" />
                        <TableColumn fx:id="nameCol" prefWidth="120.0" text="姓名" />
                        <TableColumn fx:id="rolesCol" prefWidth="250.0" text="角色" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </center>
            <right>
                <VBox fx:id="editorPane" spacing="20.0" style="-fx-background-color: #F7F7F7; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 0 1;" visible="false">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <Label style="-fx-font-size: 18px; -fx-font-weight: 600;" text="编辑用户" />
                    <VBox spacing="8.0">
                        <Label text="一卡通号" />
                        <Label fx:id="cardNumLabel" style="-fx-font-weight: bold;" text="-" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label text="姓名" />
                        <Label fx:id="nameLabel" style="-fx-font-weight: bold;" text="-" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label text="角色 (逗号分隔)" />
                        <JFXTextField fx:id="rolesField" promptText="例如: student,teacher" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label text="新密码 (留空则不修改)" />
                        <JFXPasswordField fx:id="passwordField" promptText="输入新密码" />
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <JFXButton fx:id="saveButton" buttonType="RAISED" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="保存更改" />
                    </HBox>
                </VBox>
            </right>
        </BorderPane>
    </VBox>
</AnchorPane>