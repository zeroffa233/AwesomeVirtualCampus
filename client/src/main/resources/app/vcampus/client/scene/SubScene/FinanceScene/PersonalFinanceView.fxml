<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXListView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:controller="app.vcampus.client.scene.SubScene.FinanceScene.PersonalFinanceController" prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #FAFAFA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="40.0" left="100.0" right="100.0" top="40.0" />
    </padding>
    <children>
        <Label text="一卡通" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
        <Label text="查看一卡通余额与账单" style="-fx-font-size: 14px; -fx-text-fill: #666666;" />

        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <children>
                <Label text="卡内余额" style="-fx-font-size: 16px; -fx-text-fill: #607830DE;" />
                <Label fx:id="balanceLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #728748;" text="0.00 元">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>

        <VBox VBox.vgrow="ALWAYS">
            <children>
                <Label text="账单" style="-fx-font-size: 20px; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
                <JFXListView fx:id="transactionsListView" style="-fx-background-insets: 0; -fx-background-color: transparent;" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </children>
</VBox>