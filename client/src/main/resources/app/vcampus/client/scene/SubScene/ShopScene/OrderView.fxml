<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.vcampus.client.scene.OrderController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20.0">
                    <children>
                        <VBox fx:id="mainContainer" alignment="TOP_LEFT" maxWidth="1000.0" spacing="20.0">
                            <children>
                                <!-- 1. 静态标题部分 (已移除 translateX) -->
                                <VBox maxWidth="1000.0" prefWidth="1000.0" spacing="10.0" translateX="-5">
                                    <children>
                                        <Label text="我的订单" translateX="-3">
                                            <font>
                                                <Font name="System Bold" size="32.0" />
                                            </font>
                                        </Label>
                                        <Label text="查看所有订单" textFill="#616161">
                                            <font>
                                                <Font size="18.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <!-- 2. 动态订单列表容器 -->
                                <VBox fx:id="ordersListContainer" spacing="40.0" translateX="-4"/>
                            </children>
                        </VBox>
                    </children>
                    <!-- 【关键修改 2】左右内边距统一为 100.0 -->
                    <padding>
                        <Insets bottom="40.0" left="100.0" right="100.0" top="40.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
