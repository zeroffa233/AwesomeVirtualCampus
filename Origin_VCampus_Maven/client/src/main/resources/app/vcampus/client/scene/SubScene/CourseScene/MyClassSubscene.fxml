<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import com.jfoenix.controls.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<AnchorPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.vcampus.client.scene.SubScene.CourseScene.MyClassSubsceneController">
    <children>
        <VBox fx:id="rootVBox" spacing="10.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- 标题区域 -->
            <VBox spacing="5">
                <Label text="我的课堂" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <Label text="查看教学班信息" style="-fx-text-fill: gray;" />
            </VBox>

            <!-- 列表容器 -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="classListVBox" spacing="10"/>
                </content>
            </ScrollPane>

        </VBox>
    </children>
</AnchorPane>
