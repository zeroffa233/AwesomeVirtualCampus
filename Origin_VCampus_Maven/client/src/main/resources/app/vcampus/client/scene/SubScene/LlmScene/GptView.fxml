<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXListView?>
<?import com.jfoenix.controls.JFXTextArea?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:controller="app.vcampus.client.scene.GptController" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <SplitPane dividerPositions="0.25" style="-fx-background-color: #FAFAFA;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <!-- 左侧聊天记录区域 -->
                <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: #FAFAFA;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <JFXListView fx:id="chatHistoryListView" style="-fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS" />
                        <!-- 【修改 5】将“创建新聊天”按钮的背景色改为绿色 #4EB052 -->
                        <JFXButton fx:id="newChatButton" onAction="#createNewChat" minHeight="50.0"  prefWidth="Infinity" style="-fx-background-color: #4EB052; -fx-text-fill: white; -fx-background-radius: 8;" text="创建新聊天" />
                    </children>
                </VBox>

                <!-- 右侧对话主区域 -->
                <VBox style="-fx-background-color: white;">
                    <children>
                        <!-- 对话显示区域 -->
                        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" fitToHeight="true" style="-fx-background-color: white; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="chatDisplayArea" alignment="TOP_LEFT" spacing="10.0" style="-fx-background-color: white;">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- 输入区域 -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #F5F5F5; -fx-border-color: #E0E0E0; -fx-border-width: 1 0 0 0;">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <JFXTextArea fx:id="userInputField" minHeight="150.0" HBox.hgrow="ALWAYS" promptText="输入你的消息 (Ctrl+Enter 发送)..." style="-fx-prompt-text-fill: #BDBDBD;"/>
                                <!-- 【修改 6】将“发送”按钮的背景色也改为绿色 #4EB052 -->
                                <JFXButton fx:id="sendButton" onAction="#sendMessage" maxHeight="Infinity" prefWidth="80.0" style="-fx-background-color: #4EB052; -fx-text-fill: white; -fx-background-radius: 8;" text="发送" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </children>
</AnchorPane>