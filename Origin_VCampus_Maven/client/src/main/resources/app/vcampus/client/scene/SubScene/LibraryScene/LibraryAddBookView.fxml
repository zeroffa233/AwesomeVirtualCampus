<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootPane" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.vcampus.client.scene.SubScene.LibraryScene.LibraryAddBookViewController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    <children>
        <VBox>
            <Label text="添加新图书">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>
            <Label text="在图书馆馆藏中添加一本新书" textFill="#616161">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </VBox>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0;" VBox.vgrow="ALWAYS">
            <content>
                <GridPane hgap="10.0" vgap="40.0" style="-fx-background-color: #FFFFFF;">
                    <padding>
                        <Insets top="10.0" bottom="10.0" />
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                        <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                        <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="200.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="书名" GridPane.halignment="RIGHT" />
                        <TextField fx:id="nameField" prefHeight="40" style="-fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.columnSpan="5" />

                        <Label text="作者" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
                        <TextField fx:id="authorField" prefHeight="40" style="-fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="ISBN" GridPane.halignment="RIGHT" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="isbnField" prefHeight="40" style="-fx-font-size: 14px;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="出版社" GridPane.halignment="RIGHT" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                        <TextField fx:id="pressField" prefHeight="40" style="-fx-font-size: 14px;" GridPane.columnIndex="5" GridPane.rowIndex="1" />

                        <Label text="索书号" GridPane.halignment="RIGHT" GridPane.rowIndex="2" />
                        <TextField fx:id="callNumberField" prefHeight="40" style="-fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="馆藏地" GridPane.halignment="RIGHT" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <TextField fx:id="placeField" prefHeight="40" style="-fx-font-size: 14px;" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        <Label text="封面图片链接" GridPane.halignment="RIGHT" GridPane.columnIndex="4" GridPane.rowIndex="2" />
                        <TextField fx:id="coverField" prefHeight="40" style="-fx-font-size: 14px;" GridPane.columnIndex="5" GridPane.rowIndex="2" />

                        <Label text="书籍简介" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
                        <TextArea fx:id="descriptionArea" prefHeight="200" style="-fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.columnSpan="5" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
            </content>
        </ScrollPane>
        <JFXButton fx:id="confirmButton" buttonType="RAISED" prefHeight="50" prefWidth="Infinity" style="-fx-background-color: #607830;" text="确认添加" textFill="WHITE">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </JFXButton>
        <Label fx:id="infoLabel" textFill="#D32F2F" />
    </children>
</VBox>
