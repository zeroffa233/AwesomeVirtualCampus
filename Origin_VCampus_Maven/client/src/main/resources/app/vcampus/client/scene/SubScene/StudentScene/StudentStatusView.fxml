<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import com.jfoenix.controls.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.vcampus.client.scene.StudentStatusController"
            prefWidth="1100.0" prefHeight="800.0"
            style="-fx-background-color: #f9fafc;"> <!-- 浅灰背景 -->

    <!-- 中央内容区 -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24;">
            <!-- 学籍信息展示（默认可见） -->
            <AnchorPane fx:id="studentInfoPane" visible="true">
                <children>
                    <ScrollPane fitToWidth="true" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                                style="-fx-background-color: transparent;">
                        <content>
                            <VBox spacing="20.0">
                                <Label text="个人学籍信息"
                                       style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:#2c3e50;"
                                       alignment="CENTER"/>

                                <GridPane hgap="16" vgap="16">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" percentWidth="20"/>
                                        <ColumnConstraints percentWidth="30"/>
                                        <ColumnConstraints halignment="RIGHT" percentWidth="20"/>
                                        <ColumnConstraints percentWidth="30"/>
                                    </columnConstraints>

                                    <!-- 姓 名 -->
                                    <Label text="姓" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <JFXTextField fx:id="familyNameField"  labelFloat="true"
                                                  GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false"/>

                                    <Label text="名" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <JFXTextField fx:id="givenNameField"  labelFloat="true"
                                                  GridPane.rowIndex="0" GridPane.columnIndex="3" editable="false"/>

                                    <!-- 性别 出生日期 -->
                                    <Label text="性别" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <JFXTextField fx:id="genderField" labelFloat="true"
                                                  GridPane.rowIndex="1" GridPane.columnIndex="1" editable="false"/>

                                    <Label text="出生日期" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <JFXTextField fx:id="birthDateField" labelFloat="true"
                                                  GridPane.rowIndex="1" GridPane.columnIndex="3" editable="false"/>

                                    <!-- 籍贯 政治面貌 学籍状态 -->
                                    <Label text="籍贯" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <JFXTextField fx:id="birthPlaceField" labelFloat="true"
                                                  GridPane.rowIndex="2" GridPane.columnIndex="1" editable="false"/>

                                    <Label text="政治面貌" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                    <JFXTextField fx:id="politicalStatusField" labelFloat="true"
                                                  GridPane.rowIndex="2" GridPane.columnIndex="3" editable="false"/>

                                    <Label text="学籍状态" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                    <JFXTextField fx:id="statusField" labelFloat="true"
                                                  GridPane.rowIndex="3" GridPane.columnIndex="1" editable="false"/>

                                    <!-- 专业 学院 -->
                                    <Label text="专业" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                    <JFXTextField fx:id="majorField" labelFloat="true"
                                                  GridPane.rowIndex="4" GridPane.columnIndex="1" editable="false"/>

                                    <Label text="学院" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                                    <JFXTextField fx:id="schoolField" labelFloat="true"
                                                  GridPane.rowIndex="4" GridPane.columnIndex="3" editable="false"/>

                                    <!-- 学号 一卡通号 -->
                                    <Label text="学号" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                    <JFXTextField fx:id="studentNumberField" labelFloat="true"
                                                  GridPane.rowIndex="5" GridPane.columnIndex="1" editable="false"/>

                                    <Label text="一卡通号" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
                                    <JFXTextField fx:id="cardNumberField" labelFloat="true"
                                                  GridPane.rowIndex="5" GridPane.columnIndex="3" editable="false"/>
                                </GridPane>
                            </VBox>
                        </content>
                    </ScrollPane>
                </children>
            </AnchorPane>
        </StackPane>
    </center>
</BorderPane>
