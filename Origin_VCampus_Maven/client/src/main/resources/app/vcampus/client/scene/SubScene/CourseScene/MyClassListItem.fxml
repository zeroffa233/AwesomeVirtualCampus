<?import javafx.scene.layout.*?>
<?import com.jfoenix.controls.*?>
<?import javafx.scene.control.Label?>

<!-- 使用 fx:root，自定义控件由 Java 端注入 -->
<fx:root type="HBox"
         xmlns="http://javafx.com/javafx/20"
         xmlns:fx="http://javafx.com/fxml/1"
         spacing="16"
         styleClass="class-item-card">

    <VBox spacing="8" styleClass="class-info-section">
        <HBox spacing="8" styleClass="class-header">
            <Label fx:id="courseNameLabel" styleClass="class-course-name"/>
            <Label fx:id="courseIdLabel" styleClass="class-course-id"/>
        </HBox>
        <VBox spacing="4" styleClass="class-meta-info">
            <Label fx:id="scheduleLabel"/>
            <Label fx:id="placeLabel"/>
        </VBox>
    </VBox>

    <Pane HBox.hgrow="ALWAYS"/>
    <JFXButton text="导出学生名单" fx:id="exportButton" styleClass="export-button"/>
</fx:root>