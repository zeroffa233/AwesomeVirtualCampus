<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.vcampus.client.scene.SubScene.LibraryScene.LibraryHistoryViewController">
    <padding>
        <Insets bottom="40.0" left="100.0" right="100.0" top="40.0" />
    </padding>
    <children>
        <VBox>
            <Label text="我的借阅">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>
            <Label text="查看我的当前借阅与历史记录" textFill="#616161">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </VBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background-insets: 0;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="resultsVBox" spacing="15.0" />
            </content>
        </ScrollPane>
    </children>
</VBox>